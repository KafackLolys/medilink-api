# Local MediLink API configuration. Copy to .env and fill in real credentials.
PORT=3000

# Firebase project shared with the MediLink Flutter and web clients.
FIREBASE_PROJECT_ID=medilink-2027
FIREBASE_CLIENT_EMAIL=
# Paste the service-account private key; when stored on one line, represent line breaks as literal \n sequences.
FIREBASE_PRIVATE_KEY=
# Firebase Web API key from the same Firebase project (public client configuration).
FIREBASE_WEB_API_KEY=

# Novu push delivery for the Flutter client only.
# Use the HTTPS API origin (not the dashboard URL and not an URL ending in /v1).
# Keep these secrets on the backend; never add them to Flutter .env.json.
NOVU_API_BASE_URL=
NOVU_SECRET_KEY=
NOVU_WORKFLOW_ID=
# Optional when Novu has exactly one active FCM integration.
NOVU_FCM_INTEGRATION_IDENTIFIER=

# Optional: required only for medical document uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=images

# Optional alternative to the three FIREBASE_* service-account fields above.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/medilink-service-account.json
